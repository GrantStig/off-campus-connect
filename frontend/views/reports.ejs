<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Reports — Off Campus Connect</title>
    <link rel="stylesheet" href="/style.css">
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
</head>
<body>
    <nav>
        <a href="/" class="logo">
            <span class="icon">🏠</span>
            Off Campus Connect
        </a>
        <div class="nav-links">
            <a href="/">Home</a>
            <a href="/properties">Properties</a>
            <a href="/reviews">Reviews</a>
            <a href="/users">Users</a>
            <a href="/compatibility">Compatibility</a>
            <a href="/reports" class="active">Reports</a>
        </div>
    </nav>

    <div class="container">
        <div class="page-header">
            <h1>Reports</h1>
            <p>Live analytics generated from housing and review data</p>
        </div>

        <!-- REPORT 1 -->
        <div class="card" style="margin-bottom: 1.5rem;">
            <div class="card-header">
                <h2>Report 1 — Property Rating Summary</h2>
            </div>
            <p style="padding: 0 1.5rem; color: #666; font-size: 14px; margin-bottom: 1rem;">
                This report joins the <strong>Property</strong>, <strong>Landlord_Profile</strong>, and <strong>Review</strong> tables
                to calculate the average star rating and total number of reviews per listing.
                It helps students identify the highest-rated properties and gives landlords
                visibility into how their units are perceived on the platform.
            </p>
            <div style="padding: 0 1.5rem 1.5rem;">
                <canvas id="ratingsChart" height="100"></canvas>
            </div>
            <div class="table-wrapper">
                <table>
                    <thead>
                        <tr>
                            <th>Address</th>
                            <th>Landlord</th>
                            <th>Rent</th>
                            <th>Bed / Bath</th>
                            <th>Avg Rating</th>
                            <th>Total Reviews</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% propertyRatings.forEach(p => { %>
                        <tr>
                            <td><strong><%= p.address %>, <%= p.city %></strong></td>
                            <td><%= p.landlord %></td>
                            <td>$<%= parseFloat(p.rent_price).toFixed(2) %></td>
                            <td><%= p.bedroom_count %>bd / <%= p.bathroom_count %>ba</td>
                            <td><%= p.avg_rating !== null ? p.avg_rating + ' / 5' : 'No reviews' %></td>
                            <td><%= p.total_reviews %></td>
                        </tr>
                        <% }) %>
                    </tbody>
                </table>
            </div>
            <div style="margin: 1rem 1.5rem; background: #f8f8f8; border-left: 3px solid #6B1E3A; padding: 12px 16px; font-family: monospace; font-size: 12px; color: #555; border-radius: 0 4px 4px 0; white-space: pre-wrap;">SELECT p.address, p.city, lp.company_name AS landlord, p.rent_price,
       COUNT(r.review_id) AS total_reviews, ROUND(AVG(r.rating), 2) AS avg_rating
FROM Property p
JOIN Landlord_Profile lp ON p.landlord_id = lp.landlord_id
LEFT JOIN Review r ON r.property_id = p.property_id
GROUP BY p.property_id
ORDER BY avg_rating DESC</div>
        </div>

        <!-- REPORT 2 -->
        <div class="card" style="margin-bottom: 1.5rem;">
            <div class="card-header">
                <h2>Report 2 — Landlord Portfolio Summary</h2>
            </div>
            <p style="padding: 0 1.5rem; color: #666; font-size: 14px; margin-bottom: 1rem;">
                This report joins the <strong>User</strong>, <strong>Landlord_Profile</strong>, and <strong>Property</strong> tables
                to summarize each landlord's total listings, available units, and average rent price.
                It helps admins monitor platform activity and allows students to compare
                property managers at a glance.
            </p>
            <div style="padding: 0 1.5rem 1.5rem;">
                <canvas id="landlordChart" height="100"></canvas>
            </div>
            <div class="table-wrapper">
                <table>
                    <thead>
                        <tr>
                            <th>Username</th>
                            <th>Company</th>
                            <th>Total Properties</th>
                            <th>Available Units</th>
                            <th>Avg Rent</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% landlordSummary.forEach(l => { %>
                        <tr>
                            <td><%= l.landlord %></td>
                            <td><strong><%= l.company_name %></strong></td>
                            <td><%= l.total_properties %></td>
                            <td>
                                <% if (l.available_units > 0) { %>
                                    <span class="badge badge-available"><%= l.available_units %></span>
                                <% } else { %>
                                    <span class="badge badge-unavailable">0</span>
                                <% } %>
                            </td>
                            <td>$<%= l.avg_rent !== null ? parseFloat(l.avg_rent).toFixed(2) : 'N/A' %></td>
                        </tr>
                        <% }) %>
                    </tbody>
                </table>
            </div>
            <div style="margin: 1rem 1.5rem; background: #f8f8f8; border-left: 3px solid #6B1E3A; padding: 12px 16px; font-family: monospace; font-size: 12px; color: #555; border-radius: 0 4px 4px 0; white-space: pre-wrap;">SELECT u.username AS landlord, lp.company_name,
       COUNT(p.property_id) AS total_properties,
       SUM(p.available = TRUE) AS available_units,
       ROUND(AVG(p.rent_price), 2) AS avg_rent
FROM User u
JOIN Landlord_Profile lp ON lp.landlord_id = u.user_id
LEFT JOIN Property p ON p.landlord_id = u.user_id
GROUP BY u.user_id
ORDER BY total_properties DESC</div>
        </div>

    </div>

    <script>
        const ratingsData = <%- JSON.stringify(propertyRatings) %>;
        const landlordData = <%- JSON.stringify(landlordSummary) %>;

        new Chart(document.getElementById('ratingsChart'), {
            type: 'bar',
            data: {
                labels: ratingsData.map(p => p.address),
                datasets: [{
                    label: 'Average Rating',
                    data: ratingsData.map(p => p.avg_rating || 0),
                    backgroundColor: '#6B1E3A',
                    borderRadius: 4,
                }]
            },
            options: {
                responsive: true,
                scales: {
                    y: {
                        min: 0, max: 5,
                        ticks: { stepSize: 1 },
                        title: { display: true, text: 'Avg Star Rating' }
                    },
                    x: { ticks: { maxRotation: 45, font: { size: 11 } } }
                },
                plugins: {
                    legend: { display: false },
                    title: { display: true, text: 'Average Review Rating by Property' }
                }
            }
        });

        new Chart(document.getElementById('landlordChart'), {
            type: 'bar',
            data: {
                labels: landlordData.map(l => l.company_name),
                datasets: [
                    {
                        label: 'Total Properties',
                        data: landlordData.map(l => l.total_properties),
                        backgroundColor: '#6B1E3A',
                        borderRadius: 4,
                    },
                    {
                        label: 'Available Units',
                        data: landlordData.map(l => l.available_units),
                        backgroundColor: '#c06080',
                        borderRadius: 4,
                    }
                ]
            },
            options: {
                responsive: true,
                scales: {
                    y: {
                        beginAtZero: true,
                        ticks: { stepSize: 1 },
                        title: { display: true, text: 'Number of Properties' }
                    }
                },
                plugins: {
                    title: { display: true, text: 'Total vs Available Properties by Landlord' }
                }
            }
        });
    </script>
</body>
</html>