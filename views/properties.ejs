<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Properties — Off Campus Connect</title>
    <link rel="stylesheet" href="/style.css">
</head>
<body>
    <nav>
        <a href="/" class="logo">
            <span class="icon">🏠</span>
            Off Campus Connect
        </a>
        <div class="nav-links">
            <a href="/">Home</a>
            <a href="/properties" class="active">Properties</a>
            <a href="/reviews">Reviews</a>
            <a href="/users">Users</a>
        </div>
    </nav>

    <div class="container">
        <div class="page-header">
            <h1>Properties</h1>
            <p>Manage off-campus housing listings in Blacksburg</p>
        </div>

        <% if (success) { %>
            <div class="alert alert-success">✓ <%= success %></div>
        <% } %>
        <% if (error) { %>
            <div class="alert alert-error">✕ <%= error %></div>
        <% } %>

        <!-- ADD PROPERTY FORM -->
        <div class="card" style="margin-bottom: 1.5rem;">
            <div class="card-header">
                <h2>Add New Property</h2>
            </div>
            <form action="/properties/add" method="POST">
                <div class="form-grid">
                    <div class="form-group">
                        <label>Landlord</label>
                        <select name="landlord_id" required>
                            <option value="">Select landlord...</option>
                            <% landlords.forEach(l => { %>
                                <option value="<%= l.landlord_id %>"><%= l.company_name %></option>
                            <% }) %>
                        </select>
                    </div>
                    <div class="form-group">
                        <label>Address</label>
                        <input type="text" name="address" placeholder="123 Main St" required>
                    </div>
                    <div class="form-group">
                        <label>City</label>
                        <input type="text" name="city" value="Blacksburg" required>
                    </div>
                    <div class="form-group">
                        <label>State</label>
                        <input type="text" name="state" value="VA" required>
                    </div>
                    <div class="form-group">
                        <label>ZIP Code</label>
                        <input type="text" name="zip" value="24060" required>
                    </div>
                    <div class="form-group">
                        <label>Monthly Rent ($)</label>
                        <input type="number" name="rent_price" step="0.01" placeholder="800.00" required>
                    </div>
                    <div class="form-group">
                        <label>Bedrooms</label>
                        <input type="number" name="bedroom_count" min="0" required>
                    </div>
                    <div class="form-group">
                        <label>Bathrooms</label>
                        <input type="number" name="bathroom_count" min="0" required>
                    </div>
                    <div class="form-group">
                        <label>Available</label>
                        <select name="available">
                            <option value="1">Yes</option>
                            <option value="0">No</option>
                        </select>
                    </div>
                    <div class="form-group full-width">
                        <label>Description</label>
                        <textarea name="description" placeholder="Describe the property..."></textarea>
                    </div>
                </div>
                <div class="form-actions">
                    <button type="submit" class="btn btn-primary">+ Add Property</button>
                </div>
            </form>
        </div>

        <!-- PROPERTY LIST TABLE -->
        <div class="card">
            <div class="card-header">
                <h2>All Properties (<%= properties.length %>)</h2>
            </div>
            <div class="table-wrapper">
                <table>
                    <thead>
                        <tr>
                            <th>ID</th>
                            <th>Address</th>
                            <th>City</th>
                            <th>Rent</th>
                            <th>Bed / Bath</th>
                            <th>Landlord</th>
                            <th>Status</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% properties.forEach(p => { %>
                        <tr>
                            <td><%= p.property_id %></td>
                            <td><strong><%= p.address %></strong></td>
                            <td><%= p.city %>, <%= p.state %></td>
                            <td>$<%= parseFloat(p.rent_price).toFixed(2) %></td>
                            <td><%= p.bedroom_count %>bd / <%= p.bathroom_count %>ba</td>
                            <td><%= p.company_name %></td>
                            <td>
                                <% if (p.available) { %>
                                    <span class="badge badge-available">Available</span>
                                <% } else { %>
                                    <span class="badge badge-unavailable">Unavailable</span>
                                <% } %>
                            </td>
                            <td class="actions">
                                <button class="btn btn-outline btn-sm edit-property-btn"
                                    data-id="<%= p.property_id %>"
                                    data-landlord="<%= p.landlord_id %>"
                                    data-address="<%= p.address %>"
                                    data-city="<%= p.city %>"
                                    data-state="<%= p.state %>"
                                    data-zip="<%= p.zip %>"
                                    data-rent="<%= p.rent_price %>"
                                    data-bed="<%= p.bedroom_count %>"
                                    data-bath="<%= p.bathroom_count %>"
                                    data-available="<%= p.available ? 1 : 0 %>"
                                    data-desc="<%= (p.description || '').replace(/"/g, '&quot;') %>"
                                >Edit</button>
                                <form action="/properties/delete/<%= p.property_id %>" method="POST" style="display:inline" onsubmit="return confirm('Delete this property?')">
                                    <button type="submit" class="btn btn-danger btn-sm">Delete</button>
                                </form>
                            </td>
                        </tr>
                        <% }) %>
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <!-- EDIT MODAL -->
    <div class="modal-backdrop" id="editModal">
        <div class="modal">
            <h2>Edit Property</h2>
            <form id="editForm" method="POST">
                <div class="form-grid">
                    <div class="form-group">
                        <label>Landlord</label>
                        <select name="landlord_id" id="edit_landlord_id" required>
                            <% landlords.forEach(l => { %>
                                <option value="<%= l.landlord_id %>"><%= l.company_name %></option>
                            <% }) %>
                        </select>
                    </div>
                    <div class="form-group">
                        <label>Address</label>
                        <input type="text" name="address" id="edit_address" required>
                    </div>
                    <div class="form-group">
                        <label>City</label>
                        <input type="text" name="city" id="edit_city" required>
                    </div>
                    <div class="form-group">
                        <label>State</label>
                        <input type="text" name="state" id="edit_state" required>
                    </div>
                    <div class="form-group">
                        <label>ZIP Code</label>
                        <input type="text" name="zip" id="edit_zip" required>
                    </div>
                    <div class="form-group">
                        <label>Monthly Rent ($)</label>
                        <input type="number" name="rent_price" id="edit_rent_price" step="0.01" required>
                    </div>
                    <div class="form-group">
                        <label>Bedrooms</label>
                        <input type="number" name="bedroom_count" id="edit_bedroom_count" min="0" required>
                    </div>
                    <div class="form-group">
                        <label>Bathrooms</label>
                        <input type="number" name="bathroom_count" id="edit_bathroom_count" min="0" required>
                    </div>
                    <div class="form-group">
                        <label>Available</label>
                        <select name="available" id="edit_available">
                            <option value="1">Yes</option>
                            <option value="0">No</option>
                        </select>
                    </div>
                    <div class="form-group full-width">
                        <label>Description</label>
                        <textarea name="description" id="edit_description"></textarea>
                    </div>
                </div>
                <div class="form-actions">
                    <button type="submit" class="btn btn-primary">Save Changes</button>
                    <button type="button" class="btn btn-outline" onclick="closeModal()">Cancel</button>
                </div>
            </form>
        </div>
    </div>

    <script>
        document.querySelectorAll('.edit-property-btn').forEach(btn => {
            btn.addEventListener('click', function() {
                document.getElementById('editForm').action = '/properties/update/' + this.dataset.id;
                document.getElementById('edit_landlord_id').value = this.dataset.landlord;
                document.getElementById('edit_address').value = this.dataset.address;
                document.getElementById('edit_city').value = this.dataset.city || '';
                document.getElementById('edit_state').value = this.dataset.state || '';
                document.getElementById('edit_zip').value = this.dataset.zip || '';
                document.getElementById('edit_rent_price').value = this.dataset.rent;
                document.getElementById('edit_bedroom_count').value = this.dataset.bed;
                document.getElementById('edit_bathroom_count').value = this.dataset.bath;
                document.getElementById('edit_available').value = this.dataset.available;
                document.getElementById('edit_description').value = this.dataset.desc || '';
                document.getElementById('editModal').classList.add('open');
            });
        });

        function closeModal() {
            document.querySelectorAll('.modal-backdrop').forEach(m => m.classList.remove('open'));
        }

        document.querySelectorAll('.modal-backdrop').forEach(m => {
            m.addEventListener('click', (e) => { if (e.target === m) closeModal(); });
        });
    </script>
</body>
</html>
